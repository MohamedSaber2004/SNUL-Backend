{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Ocelot": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "https://snul-gateway.runasp.net",
      "http://snul-gateway.runasp.net",
      "https://snul.health",
      "https://app.snul.health",
      "https://admin.snul.health"
    ]
  },
  "RateLimiting": {
    "PermitLimit": 100,
    "WindowSeconds": 60,
    "QueueLimit": 0
  },
  "OpenApiAggregator": {
    "TimeoutSeconds": 15,
    "RetryCount": 1
  },
  "JwtSettings": {
    "Issuer": "https://snul-authservice.runasp.net/",
    "Audience": "https://snul-authservice.runasp.net/",
    "ValidIssuers": [
      "https://snul-authservice.runasp.net/",
      "http://snul-authservice.runasp.net/",
      "https://snul-gateway.runasp.net/",
      "http://snul-gateway.runasp.net/"
    ],
    "ValidAudiences": [
      "https://snul-authservice.runasp.net/",
      "http://snul-authservice.runasp.net/",
      "https://snul-gateway.runasp.net/",
      "http://snul-gateway.runasp.net/"
    ],
    "ExpiryInMinutes": 60,
    "RefreshTokenExpiryDays": 30,
    "Secret": "hVT3#GVSSd5ON(YS!zBj6U4Q]|nDQaK*D-}$XPu@7eRFIe[8x&zNue3x]b(NM+9@IEh{Z}mS){sz*,I>:&F4.P"
  },
  "WelcoIntegration": {
    "BaseUrl": "https://welco-gateway.runasp.net",
    "ServiceSecret": "SnulToWelcoIntegration!SecureSecret2026#Key@32chars",
    "ServiceIssuer": "snul-integration",
    "ServiceAudience": "welco-integration",
    "TokenExpiryMinutes": 55,
    "TimeoutSeconds": 30,
    "RetryCount": 3,
    "Routes": {
      "OrdersBase": "api/integration/orders",
      "OrdersGetById": "{0}",
      "OrdersUpdateStatus": "{0}/status",
      "InventoryBase": "api/integration/inventory",
      "InventoryCheck": "check",
      "InventoryReserve": "reserve",
      "ProductsBase": "api/integration/products",
      "ProductsGetById": "{0}",
      "ProvidersBase": "api/integration/providers",
      "QuotesBase": "api/integration/quotes",
      "QuotesUpdateStatus": "{0}/status",
      "CategoriesBase": "api/integration/categories",
      "CategoriesGetById": "{0}"
    }
  }
}
