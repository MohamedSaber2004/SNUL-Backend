{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Ocelot": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "https://localhost:7266",
      "http://localhost:5393",
      "http://localhost:56304",
      "https://snul-gateway.runasp.net"
    ]
  },
  "RateLimiting": {
    "PermitLimit": 400,
    "WindowSeconds": 60,
    "QueueLimit": 0
  },
  "OpenApiAggregator": {
    "TimeoutSeconds": 15,
    "RetryCount": 1
  },
  "JwtSettings": {
    "Issuer": "https://snul-authservice.runasp.net/",
    "Audience": "https://snul-authservice.runasp.net/",
    "ValidIssuers": [
      "https://snul-authservice.runasp.net/",
      "http://snul-authservice.runasp.net/",
      "https://snul-gateway.runasp.net/",
      "http://snul-gateway.runasp.net/",
      "https://localhost:7303/",
      "http://localhost:5166/",
      "https://localhost:7266/",
      "http://localhost:5393/"
    ],
    "ValidAudiences": [
      "https://snul-authservice.runasp.net/",
      "http://snul-authservice.runasp.net/",
      "https://snul-gateway.runasp.net/",
      "http://snul-gateway.runasp.net/",
      "https://localhost:7303/",
      "http://localhost:5166/",
      "https://localhost:7266/",
      "http://localhost:5393/"
    ],
    "ExpiryInMinutes": 60,
    "RefreshTokenExpiryDays": 30,
    "Secret": "hVT3#GVSSd5ON(YS!zBj6U4Q]|nDQaK*D-}$XPu@7eRFIe[8x&zNue3x]b(NM+9@IEh{Z}mS){sz*,I>:&F4.P"
  }
}
