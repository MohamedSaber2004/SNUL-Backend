<Project>
  <PropertyGroup>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <!-- Keep BOTH win-x64 and win-x86 SNI/SQL native assets: RunASP IIS pools may run 32-bit.
       A missing win-x86 SNI causes DllNotFoundException 'Microsoft.Data.SqlClient.SNI.dll' (0x8007007E)
       on every DB open (login 500, silent seeding failure, Product 500.30). Only linux/osx/arm are stripped. -->
  <Target Name="FilterUnneededRuntimes" AfterTargets="ResolvePackageAssets">
    <ItemGroup>
      <RuntimeTargetsCopyLocalItems Remove="@(RuntimeTargetsCopyLocalItems)" Condition="$([System.String]::new('%(RuntimeTargetsCopyLocalItems.Identity)').Contains('/linux-')) or $([System.String]::new('%(RuntimeTargetsCopyLocalItems.Identity)').Contains('\linux-')) or $([System.String]::new('%(RuntimeTargetsCopyLocalItems.Identity)').Contains('/osx-')) or $([System.String]::new('%(RuntimeTargetsCopyLocalItems.Identity)').Contains('\osx-')) or $([System.String]::new('%(RuntimeTargetsCopyLocalItems.Identity)').Contains('/win-arm')) or $([System.String]::new('%(RuntimeTargetsCopyLocalItems.Identity)').Contains('\win-arm'))" />
      <NativeCopyLocalItems Remove="@(NativeCopyLocalItems)" Condition="$([System.String]::new('%(NativeCopyLocalItems.Identity)').Contains('/linux-')) or $([System.String]::new('%(NativeCopyLocalItems.Identity)').Contains('\linux-')) or $([System.String]::new('%(NativeCopyLocalItems.Identity)').Contains('/osx-')) or $([System.String]::new('%(NativeCopyLocalItems.Identity)').Contains('\osx-')) or $([System.String]::new('%(NativeCopyLocalItems.Identity)').Contains('/win-arm')) or $([System.String]::new('%(NativeCopyLocalItems.Identity)').Contains('\win-arm'))" />
    </ItemGroup>
  </Target>
</Project>
